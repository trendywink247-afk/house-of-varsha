{
  "mcpServers": {
    "claude-flow": {
      "command": "sh",
      "args": [
        "-c",
        "set -a && . \"$HOME/house-of-varsha-src/.claude-flow/.env\" && set +a && npx -y @claude-flow/cli@latest mcp start"
